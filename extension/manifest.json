{
  "manifest_version": 3,
  "name": "PaneParcel",
  "version": "0.3.0.1",
  "description": "Annotate web pages and send your notes to Claude Code or Codex in Rex.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "icons": {
    "16": "icons/paneparcel-16.png",
    "24": "icons/paneparcel-24.png",
    "32": "icons/paneparcel-32.png",
    "48": "icons/paneparcel-48.png",
    "128": "icons/paneparcel-128.png"
  },
  "action": {
    "default_title": "Annotate this page with PaneParcel",
    "default_icon": {
      "16": "icons/paneparcel-16.png",
      "24": "icons/paneparcel-24.png",
      "32": "icons/paneparcel-32.png",
      "48": "icons/paneparcel-48.png",
      "128": "icons/paneparcel-128.png"
    }
  },
  "optional_host_permissions": [
    "file:///*"
  ],
  "version_name": "0.3.0-beta.1"
}
